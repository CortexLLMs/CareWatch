# ── CareWatch : configuration du backend ──────────────────────────────
# Copier ce fichier en « .env » puis compléter les clés.

# ── Novu (notifications multicanal : Telegram, e-mail, in-app) ───────
# Novu Cloud (région US) : https://api.novu.co → Settings → API keys
NOVU_API_URL=https://api.novu.co
# Clé API secrète du tableau de bord Novu
NOVU_API_KEY=
# Identifiant du workflow Novu (ex. alerte-carewatch)
NOVU_WORKFLOW=alerte-carewatch
# Abonné par défaut si l'utilisateur n'en fournit pas
NOVU_SUBSCRIBER=carewatch-user
# Délai maximal d'appel Novu (ms)
NOVU_TIMEOUT=6000
# "1" = mode simulation : aucune requête sortante, utile sans Novu
NOVU_MOCK=1

# ── Telegram : alerte directe sur anomalie (critical / high) ──────────
# Bot créé via @BotFather ; chat_id via /getUpdates après /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=6000

# ── E-mail (Resend) : rappels de médicaments ─────────────────────────
# RESEND_KEY=re_xxxxxxxxxxxx
# FROM_EMAIL=onboarding@resend.dev
# FROM_NAME=CareWatch
